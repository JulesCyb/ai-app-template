# --- App ---
APP_NAME=ai-app
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# App role: no superuser, NOBYPASSRLS — Row-Level Security only applies this way
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Owner/superuser role for migrations and seed only
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- Models (provider abstraction, see app/llm.py) ---
# Model name in PydanticAI format "<provider>:<model>"; use a current model
LLM_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: route everything through the LiteLLM gateway (then LLM_MODEL = name from litellm/config.yaml)
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Embeddings (OpenAI-compatible, optionally via LiteLLM); dimension must match the migration (1536)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Auth (DEV) ---
# dev-headers: X-Tenant-Id / X-User-Id on the request. Replace with JWT/OIDC before production (app/deps.py).
AUTH_MODE=dev-headers

# --- Observability (Langfuse via OTel, optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP server (DEV: context from the environment; from auth in production) ---
MCP_TENANT_ID=
MCP_USER_ID=
