# --- App ---
APP_NAME=ai-app
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:3000

# --- Datenbank ---
# App-Rolle: kein Superuser, NOBYPASSRLS – nur so greift Row-Level Security
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Owner-/Superuser-Rolle nur für Migrationen und Seed
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- Modelle (Provider-Abstraktion, siehe app/llm.py) ---
# Modellname im PydanticAI-Format "<provider>:<model>", aktuelles Modell eintragen
LLM_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: alles über LiteLLM-Gateway routen (dann LLM_MODEL = Name aus litellm/config.yaml)
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Embeddings (OpenAI-kompatibel, ggf. über LiteLLM); Dimension muss zur Migration passen (1536)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Auth (DEV) ---
# dev-headers: X-Tenant-Id / X-User-Id im Request. Vor Produktion durch JWT/OIDC ersetzen (app/deps.py).
AUTH_MODE=dev-headers

# --- Observability (Langfuse über OTel, optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- MCP-Server (DEV: Kontext aus Umgebung, in Produktion aus Auth) ---
MCP_TENANT_ID=
MCP_USER_ID=
